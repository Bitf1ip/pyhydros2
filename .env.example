# Copy this file to `.env` (never commit the real file) and fill in your
# HYDROS API credentials. See README.md "Getting credentials" for how to
# obtain them.
HYDROS_PROVIDER_KEY=your-provider-key-here
HYDROS_DEVICE_KEY=your-device-key-here

# Optional overrides for examples/demo.py
# HYDROS_BASE_URL=https://api.coralvuehydros.com
# HYDROS_POLL_DURATION_SECONDS=120
# HYDROS_POLL_INTERVAL_SECONDS=6
# HYDROS_LOG_HOURS=1
